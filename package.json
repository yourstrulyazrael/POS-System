{
  "name": "clover-pos",
  "productName": "Clover POS",
  "version": "1.1.3",
  "description": "Point of sale for Clover & Co.",
  "author": "Clover & Co.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "desktop": "next build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:win": "next build && electron-builder --win nsis",
    "release:win": "next build && electron-builder --win nsis --publish always",
    "update:test": "node scripts/update-test.mjs build-and-serve",
    "update:test-launch": "node scripts/update-test.mjs launch"
  },
  "build": {
    "appId": "co.clover.pos",
    "productName": "Clover POS",
    "copyright": "Copyright © 2026 Clover & Co.",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clover POS",
      "artifactName": "Clover-POS-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yourstrulyazrael",
        "repo": "POS-System",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "fflate": "0.8.2",
    "lucide-react": "^0.511.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "postcss": "^8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
