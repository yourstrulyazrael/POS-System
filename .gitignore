# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# build/ holds electron-builder resources; only the app icon is source.
/build/*
!/build/icon.png

# desktop installers (electron-builder output)
/dist-desktop/
/dist-update-test/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*.local
.env

# supabase cli local state
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
